# Kopieer naar .env en vul in (docker compose), of zet dezelfde variabelen in de Portainer-stack.

# --- Cloudflare Access ---
# Teamdomein, zonder https:// (Zero Trust > Settings > Custom Pages, of de login-URL).
CF_ACCESS_TEAM_DOMAIN=jouwteam.cloudflareaccess.com
# Application Audience (AUD) Tag van de Access-applicatie (Access > Applications > Overview).
CF_ACCESS_AUD=
# Alleen voor lokaal testen zonder Cloudflare. NOOIT true laten in productie.
AUTH_DISABLED=false

# --- Webpoort ---
# 127.0.0.1 = alleen bereikbaar op deze server (cloudflared draait op de host).
# 0.0.0.0   = ook bereikbaar op het LAN (bv. als cloudflared op een andere machine draait).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- MQTT broker ---
# Eigen Mosquitto meedraaien in deze stack: COMPOSE_PROFILES=mosquitto (MQTT_HOST blijft "mosquitto").
# Bestaande broker gebruiken: COMPOSE_PROFILES leeg laten en MQTT_HOST/MQTT_PORT op die broker zetten.
COMPOSE_PROFILES=mosquitto
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Dezelfde gebruiker/wachtwoord zet je in Tasmota (MqttUser / MqttPassword).
MQTT_USER=accesscontrol
MQTT_PASSWORD=verander-dit
MQTT_PUBLISH_PORT=1883

# --- Back-ups ---
# Waar de app back-ups wegschrijft (in de app: map /backups). Leeg = Docker-volume "backups".
# Absoluut pad = map op de server, bv. /srv/accesscontrol/backups (schrijfbaar voor uid 10001:
#   sudo mkdir -p /srv/accesscontrol/backups && sudo chown 10001 /srv/accesscontrol/backups)
BACKUP_DIR=
# Client secret van de app-registratie voor SharePoint (Microsoft Graph). Nooit in de UI of database.
SHAREPOINT_CLIENT_SECRET=

LOG_LEVEL=INFO
